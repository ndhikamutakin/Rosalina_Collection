PORT=5000

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Gunakan service_role key (rahasia, hanya untuk backend, jangan dipakai di frontend)
SUPABASE_KEY=isi_service_role_key

# Kunci rahasia untuk token login (isi string acak panjang)
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=8h

# Alamat frontend yang diizinkan (pisahkan dengan koma). Kosongkan untuk mengizinkan semua saat development.
CORS_ORIGIN=http://localhost:5173
